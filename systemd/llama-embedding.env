# /mnt/sdcard/opt/llama/llama-embedding.env
# Environment configuration for EmbeddingGemma-2 Multimodal Embedding Service on Jetson AGX Xavier.

LLAMA_BIN=/home/triph/juicer/momonga-llama.cpp/build-volta/bin/llama-server
MODEL_PATH=/mnt/cache/huggingface/hub/models--unsloth--embeddinggemma-2-GGUF/snapshots/031f0d4b35536f69ab3509d4893c923264fcf253/embeddinggemma-2-Q8_0.gguf
MMPROJ_PATH=/mnt/cache/huggingface/hub/models--unsloth--embeddinggemma-2-GGUF/snapshots/031f0d4b35536f69ab3509d4893c923264fcf253/mmproj-F16.gguf
MODEL_ALIAS="embeddinggemma-2"

HOST=0.0.0.0
PORT=8086

# Context & Batching Configuration
# ubatch 4096 prevents clipping 1120 vision tokens down to 1024
CTX_SIZE=8192
BATCH=4096
UBATCH=4096
FLASH_ATTN=on

# Full GPU offloading
N_GPU_LAYERS=99

EXTRA_ARGS="--embedding"
