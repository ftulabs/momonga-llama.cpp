# /mnt/sdcard/opt/llama/llama-rerank.env
# Environment configuration for bge-reranker-v2-m3 Encoder Reranker Service on Jetson AGX Xavier.

LLAMA_BIN=/home/triph/juicer/momonga-llama.cpp/build-volta/bin/llama-server
MODEL_PATH=/mnt/cache/huggingface/hub/models--gpustack--bge-reranker-v2-m3-GGUF/snapshots/3093af03b1a635e67b084b1d8c03c5f5e020fd05/bge-reranker-v2-m3-Q8_0.gguf
MODEL_ALIAS="bge-reranker-v2-m3"

HOST=0.0.0.0
PORT=8012

# Context & Batching Configuration
# Encoder models require n_ubatch >= n_tokens; np=1 preserves full 8192 context per query+doc pair
CTX_SIZE=8192
PARALLEL=1
BATCH=8192
UBATCH=8192
FLASH_ATTN=on

# Full GPU offloading
N_GPU_LAYERS=99

EXTRA_ARGS="--reranking"
