# /mnt/sdcard/opt/llama/llama-rerank.env
# Environment configuration for zerank-2 Generative Causal Reranker Service on Jetson AGX Xavier.

LLAMA_BIN=/home/triph/juicer/momonga-llama.cpp/build-volta/bin/llama-server
MODEL_PATH=/mnt/cache/huggingface/hub/models--mradermacher--zerank-2-GGUF/snapshots/6886178557c58b375fcb79c8751673b97baeb633/zerank-2.Q8_0.gguf
MODEL_ALIAS="zerank-2"

HOST=0.0.0.0
PORT=8012

# Context & Concurrency Configuration
# Pinned 8192 context prevents default auto-allocation of 48 GB KV cache on Xavier
CTX_SIZE=8192
PARALLEL=4
BATCH=2048
UBATCH=1024
FLASH_ATTN=on

# Full GPU offloading
N_GPU_LAYERS=99

EXTRA_ARGS="--reranking"
